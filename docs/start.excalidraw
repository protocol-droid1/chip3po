    {
      "id": "4vt9YFlFid2euHVhkvkN7",
      "type": "text",
      "x": 902.6715020502655,
      "y": -146.91328841197355,
      "width": 564.259521484375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ah",
      "roundness": null,
      "seed": 714024402,
      "version": 390,
      "versionNonce": 1512824782,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791313762551,
      "link": null,
      "locked": false,
      "text": "[1] this might actually not make sense; since we are doing\n    RX and TX at the same time in full-duplex protocols,\n    there should be no reason to not have 2 cores",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[1] this might actually not make sense; since we are doing\n    RX and TX at the same time in full-duplex protocols,\n    there should be no reason to not have 2 cores",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "aOhYPa9bY58kc-IVpsZ3K",
      "type": "text",
      "x": 1025.1608486411747,
      "y": -229.69737932106443,
      "width": 626.5394287109375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ahV",
      "roundness": null,
      "seed": 392552786,
      "version": 572,
      "versionNonce": 174287118,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791313948898,
      "link": null,
      "locked": false,
      "text": "[1] the only foreseeable nuance is that we might have instr for \n    2 separate cores (one RX and one TX core)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[1] the only foreseeable nuance is that we might have instr for \n    2 separate cores (one RX and one TX core)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "LFepl8JVn2qRrDeucY2m8",
      "type": "text",
      "x": 1182.4454250970205,
      "y": -302.5272021546731,
      "width": 588.1594848632812,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ai",
      "roundness": null,
      "seed": 691927506,
      "version": 573,
      "versionNonce": 936404686,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791313790652,
      "link": null,
      "locked": false,
      "text": "[1] SPI might make the most sense here; we need something\n    that is fast and doesn't take many pins",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[1] SPI might make the most sense here; we need something\n    that is fast and doesn't take many pins",
      "autoResize": true,
      "lineHeight": 1.25
    },
