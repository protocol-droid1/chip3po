      "boundElements": [],
      "updated": 1791430247689,
      "link": null,
      "locked": false,
      "text": "while (1) \n    if (buff is full) \n        pin <- 0\n        wait\n        \n        for (bit in buff)\n            pin <- bit\n            wait\n        \n        pin <- sum(bit in buff)\n        wait\n        \n        pin <- 1\n        wait\n        pin <- 1\n        wait",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "while (1) \n    if (buff is full) \n        pin <- 0\n        wait\n        \n        for (bit in buff)\n            pin <- bit\n            wait\n        \n        pin <- sum(bit in buff)\n        wait\n        \n        pin <- 1\n        wait\n        pin <- 1\n        wait",
      "autoResize": true,
      "lineHeight": 1.25
