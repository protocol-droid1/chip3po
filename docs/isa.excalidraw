    {
      "id": "cHGW4CS3bXFC_NenZDPwV",
      "type": "text",
      "x": 1671.8216185972717,
      "y": 1312.1603527965224,
      "width": 236.31982421875,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ad",
      "roundness": null,
      "seed": 327266959,
      "version": 234,
      "versionNonce": 1149402511,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791430656259,
      "link": null,
      "locked": false,
      "text": "while (1)\n    if (pin == 0)\n        wait\n\n        for (i in range 8)\n            buff[i] <- pin\n            wait\n\n        parity_buff <- pin\n        wait\n\n        _ <- pin\n        wait\n        _ <- pin\n        wait\n        ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "while (1)\n    if (pin == 0)\n        wait\n\n        for (i in range 8)\n            buff[i] <- pin\n            wait\n\n        parity_buff <- pin\n        wait\n\n        _ <- pin\n        wait\n        _ <- pin\n        wait\n        ",
      "autoResize": true,
      "lineHeight": 1.25
    },
