    {
      "id": "cHGW4CS3bXFC_NenZDPwV",
      "type": "text",
      "x": 1671.8216185972717,
      "y": 1312.1603527965224,
      "width": 236.31982421875,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
